{
  "name": "changehouse",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "firebase emulators:exec --only auth,firestore --project demo-changehouse \"turbo run test:integration\"",
    "test:integration:run": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-changehouse --import=.emulator-data --export-on-exit",
    "db:migrate": "pnpm --filter @changehouse/api db:migrate",
    "lan:env": "node scripts/lan-env.mjs",
    "admin:grant": "pnpm --filter @changehouse/api admin:grant",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-vitest": "0.5.4",
    "firebase-tools": "15.34.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "pnpm": {
    "overrides": {
      "node-forge@<1.4.1": "^1.4.1",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
      "fast-uri@>=4.0.0 <4.2.3": "^4.2.3",
      "@grpc/grpc-js@<1.13.6": "^1.13.6",
      "body-parser@<1.20.9": "^1.20.9",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "uuid@>=9.0.0 <11.1.1": "^11.1.1"
    }
  }
}
