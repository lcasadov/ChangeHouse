---
import { es } from '../i18n/es';

const { benefits } = es;
---

<section id="ventajas" class="section" aria-labelledby="benefits-title">
  <div class="container">
    <h2 id="benefits-title" class="section-title">
      {benefits.title}
    </h2>

    <ul class="list">
      {benefits.items.map((item) => (
        <li class="item">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .list {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
  }

  .item {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding-top: var(--space-4);
    border-top: var(--border-thick) solid var(--color-brand);
  }

  h3 {
    font-size: var(--font-title-size);
    line-height: var(--font-title-line-height);
  }

  .item p {
    color: var(--color-text-muted);
  }

  @media (min-width: 600px) {
    .list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-7) var(--space-6);
    }
  }

  @media (min-width: 1024px) {
    .list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
