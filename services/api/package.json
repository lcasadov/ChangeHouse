{
  "name": "@changehouse/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@changehouse/shared": "workspace:*",
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "@google-cloud/storage": "8.4.0",
    "@sentry/node": "11.8.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "firebase-admin": "14.5.0",
    "postgres": "3.4.9",
    "sharp": "0.35.5",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
