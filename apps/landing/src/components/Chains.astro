---
import { es } from '../i18n/es';
import SwapIllustration from './SwapIllustration.astro';

const { chains } = es;
---

<section id="cadenas" class="section photo-section" aria-labelledby="chains-title">
  <img
    class="section-photo"
    src="/media/cadenas.jpg"
    alt=""
    width="1920"
    height="1080"
    loading="lazy"
    decoding="async"
  />
  <div class="container">
    <div class="card">
      <div class="copy">
        <h2 id="chains-title" class="section-title">
          {chains.title}
        </h2>
        <p class="lead">{chains.lead}</p>
        {chains.paragraphs.map((paragraph) => (
          <p class="text">{paragraph}</p>
        ))}
      </div>
      <div class="art">
        <SwapIllustration variant="chain" id="chains" />
      </div>
    </div>
  </div>
</section>

<style>
  .card {
    position: relative;
    display: grid;
    gap: var(--space-7);
    align-items: center;
    padding: var(--space-6) var(--space-5);
    border-radius: calc(var(--radius-lg) * 2);
    overflow: hidden;
  }

  .card h2,
  .lead,
  .text {
    color: var(--color-text-on-photo);
  }

  /* Momento destacado: franja del degradado de marca sobre la tarjeta */
  .card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: var(--space-2);
    background: linear-gradient(
      to right,
      var(--color-match-gradient-start),
      var(--color-match-gradient-end)
    );
  }

  .copy {
    display: grid;
    gap: var(--space-4);
  }

  .lead {
    font-size: var(--font-title-size);
    font-weight: var(--font-title-weight);
    line-height: var(--font-title-line-height);
  }

  .art {
    padding: var(--space-5);
    border-radius: calc(var(--radius-lg) * 1.5);
    background: var(--color-surface);
    max-width: var(--content-max-card);
    margin-inline: auto;
    width: 100%;
  }

  @media (min-width: 1024px) {
    .card {
      grid-template-columns: 1.1fr 0.9fr;
      padding: var(--space-8);
    }
  }
</style>
