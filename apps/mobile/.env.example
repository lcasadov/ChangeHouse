# Copia a .env para desarrollo local. Nunca se versiona .env.
# Las variables EXPO_PUBLIC_* se incrustan en la app al empaquetarla: nada secreto aqui.

# DSN de Sentry de la app. Vacio = Sentry desactivado. El valor real vive en los secretos de CI.
EXPO_PUBLIC_SENTRY_DSN=

# URL base de la API (services/api) con el prefijo /v1, sin barra final. En web, su CORS debe permitir el origen de la app (APP_ORIGIN).
EXPO_PUBLIC_API_URL=http://localhost:8080/v1
# Origen donde la landing publica /terminos y /privacidad (textos legales del alta).
EXPO_PUBLIC_LEGAL_BASE_URL=http://localhost:4321

# Firebase Auth. En local no hace falta ninguna clave real: basta el emulador (pnpm emulators).
# En DES y PROD, los valores de la app web del proyecto de Firebase (Configuracion del proyecto).
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-changehouse
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Emulador de Auth (host:puerto). SOLO en desarrollo: vacio en DES y PROD. En el emulador de Android,
# el host de tu maquina es 10.0.2.2:9099; en un movil fisico, la IP de tu maquina en la red local.
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Acceso con Google: identificador de cliente OAuth de cada plataforma (Google Cloud > Credenciales).
# El boton solo aparece en las plataformas cuyo identificador esta definido. Vacio = sin Google.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Acceso con Apple: no necesita variables. El boton aparece en iOS cuando el dispositivo lo admite
# y requiere la cuenta de Apple Developer con "Sign in with Apple" habilitado para el identificador de la app.

# Autocompletado de direcciones del alta de viviendas (Google Places API New). Clave restringida por app
# y solo para Autocomplete; la resolucion del lugar se hace en el servidor con otra clave. Vacio = se usan
# las sugerencias de prueba (lugares de packages/shared/src/fixture-places.ts), que la API local resuelve.
EXPO_PUBLIC_GOOGLE_PLACES_KEY=
