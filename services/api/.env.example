# Copia a .env para desarrollo local. Nunca se versiona .env.
PORT=8080
DATABASE_URL=postgres://changehouse:changehouse@localhost:5432/changehouse
# Proyecto de Firebase cuyos ID tokens acepta la API (obligatoria). En DES y PROD, el id real del proyecto.
FIREBASE_PROJECT_ID=demo-changehouse
# Emulador de Firebase Auth (`pnpm emulators`). SOLO en local: emite tokens sin firma, por eso la API
# se niega a arrancar en Cloud Run (K_SERVICE) si esta variable esta definida. En DES y PROD, borrala.
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8085
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
# DSN de Sentry. Vacio = Sentry desactivado. El valor real vive en Secret Manager.
SENTRY_DSN=
# Origen de la landing: el unico al que la API permite CORS. En DES y PROD, la URL publica de la landing.
LANDING_ORIGIN=http://localhost:4321
# Origenes de la app web que pueden llamar a la API con el token (lista separada por comas). En DES y PROD, la URL publica de la app.
APP_ORIGIN=http://localhost:8081
# URL publica de la app (sin barra final): los emails enlazan a <URL>/match/<id>. En DES y PROD es obligatoria (Cloud Run).
APP_PUBLIC_URL=http://localhost:8081
# Lista de espera: altas permitidas por origen (IP) en cada ventana. Ventana en segundos (600 = 10 minutos).
WAITLIST_RATE_LIMIT_MAX=5
WAITLIST_RATE_LIMIT_WINDOW=600
# Me gusta permitidos por usuario y dia natural (hora de Madrid), sumando todas sus viviendas. Sin definir: 10.
LIKES_PER_DAY=10
# Saltos de proxy de confianza para leer la IP real del cliente. Sin definir es automatico:
# 1 en Cloud Run (variable K_SERVICE) y 0 en local. No pongas mas de los que existan.
# TRUST_PROXY_HOPS=1
# Clave AES-256 (32 bytes en base64) con la que se cifra la direccion postal de las viviendas. OBLIGATORIA:
# la API no arranca sin ella. El valor de abajo es SOLO para desarrollo local; en DES y PROD vive en
# Secret Manager y es otra distinta (genera una con `openssl rand -base64 32`). Rotarla exige conservar
# la anterior hasta releer los datos: el formato guarda la version de la clave.
ADDRESS_ENCRYPTION_KEY=ZGV2LW9ubHktYWRkcmVzcy1rZXktMzItYnl0ZXMhISE=
# Clave de SERVIDOR de Google Places (Places API New) para resolver la direccion elegida en el autocompletado.
# Sin ella, en local, se usan los lugares de prueba de @changehouse/shared (FIXTURE_PLACES). En Cloud Run
# (DES y PROD) es obligatoria y vive en Secret Manager; no es la clave de la app (EXPO_PUBLIC_GOOGLE_PLACES_KEY).
GOOGLE_PLACES_SERVER_KEY=
# Fotos de las viviendas. Originales (privado, borrado automatico a las 24 h por regla de ciclo de vida) y fotos
# procesadas (publico, servido por CDN). En local son los buckets de docker-compose (`docker compose up -d storage`).
# En Cloud Run (DES y PROD) los dos nombres son obligatorios.
STORAGE_PRIVATE_BUCKET=changehouse-photos-private
STORAGE_PUBLIC_BUCKET=changehouse-photos-public
# Cloud Storage simulado (fake-gcs-server). SOLO en local: no valida las URL firmadas, por eso la API se niega
# a arrancar en Cloud Run (K_SERVICE) si esta variable esta definida. En DES y PROD, borrala.
STORAGE_EMULATOR_HOST=localhost:4443
# URL publica de las fotos (sin barra final): la CDN delante del bucket publico. Sin definir, el propio bucket
# (https://storage.googleapis.com/<bucket publico>, o el emulador en local).
# STORAGE_PUBLIC_BASE_URL=https://fotos.changehouse.app
